{
  "$schema": "https://opencode.ai/config.json",

  "model": "anthropic/claude-sonnet-4-5-20250929",
  "small_model": "anthropic/claude-haiku-4-5-20250929",

  "agent": {
    "build": {
      "model": "anthropic/claude-sonnet-4-5-20250929",
      "permission": {
        "bash": {
          "*": "deny",
          "git status *": "allow",
          "git diff *": "allow",
          "git log *": "allow",
          "grep *": "allow"
        },
        "edit": "ask"
      }
    },
    "plan": {
      "model": "anthropic/claude-haiku-4-5-20250929",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  },

  "permission": {
    "*": "ask",
    "read": "allow",
    "edit": "ask",
    "bash": {
      "*": "deny",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "grep *": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    }
  },

  "compaction": {
    "auto": true,
    "prune": true
  }
}

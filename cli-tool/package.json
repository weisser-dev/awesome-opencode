{
  "name": "@weisser-dev/awesome-opencode",
  "version": "1.5.0",
  "description": "Interactive CLI to set up OpenCode best practices: agents, skills, model optimization, and configs",
  "type": "module",
  "bin": {
    "awesome-opencode": "./src/index.js"
  },
  "files": [
    "src/",
    "templates/"
  ],
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test src/tests/*.test.js",
    "prepublishOnly": "node scripts/sync-templates.js"
  },
  "keywords": [
    "opencode",
    "ai",
    "agents",
    "skills",
    "cli",
    "setup",
    "best-practices",
    "llm",
    "mcp"
  ],
  "author": "weisser-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/weisser-dev/awesome-opencode",
    "directory": "cli-tool"
  },
  "homepage": "https://github.com/weisser-dev/awesome-opencode#readme",
  "bugs": {
    "url": "https://github.com/weisser-dev/awesome-opencode/issues"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "chalk": "^5.3.0",
    "ora": "^9.4.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

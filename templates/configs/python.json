{
  "$schema": "https://opencode.ai/config.json",

  "model": "anthropic/claude-sonnet-4-5-20250929",
  "small_model": "anthropic/claude-haiku-4-5-20250929",

  "agent": {
    "build": {
      "model": "anthropic/claude-sonnet-4-5-20250929",
      "permission": {
        "bash": {
          "*": "ask",
          "git *": "allow",
          "python *": "allow",
          "pip *": "allow",
          "pytest *": "allow",
          "poetry *": "allow",
          "uv *": "allow",
          "grep *": "allow",
          "git push *": "ask"
        }
      }
    },
    "plan": {
      "model": "anthropic/claude-haiku-4-5-20250929"
    }
  },

  "permission": {
    "edit": "allow",
    "bash": "ask"
  },

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  },

  "compaction": {
    "auto": true,
    "prune": true
  }
}
